{
  "name": "flatpak-github-actions",
  "private": true,
  "main": "dist/add-remotes/index.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc --removeComments && ncc build lib/add-remotes.js -o dist/add-remotes && ncc build lib/build-full.js -o dist/build-full",
    "format": "prettier --cache --cache-location node_modules/.cache/prettier/cache --write src/**/*.ts",
    "format-check": "prettier --cache --cache-location node_modules/.cache/prettier/cache --check src/**/*.ts",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/cache src/**/*.ts"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-github": "^5.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
