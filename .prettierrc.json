{
  "printWidth": 80,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "parser": "typescript",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": ["^@actions/(.*)$", "<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "^./stages$", "^[./]"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
